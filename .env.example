# App
AUTH_SECRET=change-me-to-a-long-random-string
NODE_ENV=production

# Database
POSTGRES_PASSWORD=change-me-to-a-long-random-hex-string
DATABASE_URL=postgresql://logos:logos@db:5432/logos?schema=public

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=logos

# Storage (inside the container)
STORAGE_DIR=/data/uploads

# Seeded admin (created on first boot if no users exist)
ADMIN_EMAIL=admin@lab.local
ADMIN_PASSWORD=changeme
